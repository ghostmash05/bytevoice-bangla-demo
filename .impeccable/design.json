  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary button from the implemented silver-frame workspace.",
      "html": "<button class=\"ds-primary\">Start voice call</button>",
      "css": ".ds-primary{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; font-size:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 15px;border:1px solid var(--primary, #273749);border-radius:9px;background:var(--primary, #273749);color:var(--primary-ink, #fff);cursor:pointer;transition:background-color .18s ease,border-color .18s ease}.ds-primary:hover:not(:disabled){background:var(--ink, #202936)}.ds-primary:focus-visible{outline:3px solid var(--focus, #467caf);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary button from the implemented silver-frame workspace.",
      "html": "<button class=\"ds-secondary\">Start voice call</button>",
      "css": ".ds-secondary{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; font-size:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 15px;border:1px solid var(--control, #c7d0db);border-radius:9px;background:var(--paper, #fff);color:var(--ink, #202936);cursor:pointer;transition:background-color .18s ease,border-color .18s ease}.ds-secondary:hover:not(:disabled){background:var(--raised, #f7f9fc)}.ds-secondary:focus-visible{outline:3px solid var(--focus, #467caf);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(max-width:760px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "Search field from the implemented silver-frame workspace.",
      "html": "<label class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search name, phone or call ID\" placeholder=\"Search name, phone or call ID\" type=\"search\"></label>",
      "css": ".ds-search{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; display:flex;align-items:center;gap:10px;max-width:470px;padding:0 12px;border:1px solid var(--control, #c7d0db);border-radius:8px;background:var(--raised, #f7f9fc);color:var(--muted, #5d6876)}.ds-search input{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; font-size:12px;min-height:42px;width:100%;min-width:0;padding:10px 0;border:0;background:transparent;color:var(--ink, #202936);caret-color:var(--accent, #335d7e)}.ds-search input::placeholder{color:var(--faint, #657383)}.ds-search:hover{border-color:var(--muted, #5d6876)}.ds-search:focus-within{outline:3px solid var(--focus, #467caf);outline-offset:2px}.ds-search input:focus-visible{outline:none}@media(max-width:760px){.ds-search input{font-size:16px;min-height:44px}}"
    },
    {
      "name": "Active navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active navigation from the implemented silver-frame workspace.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-nav-link\" href=\"#records\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/></svg>Call records</a></nav>",
      "css": ".ds-nav{padding:14px;background:var(--nav, rgba(248,250,253,.66));backdrop-filter:blur(18px)}.ds-nav-link{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; display:flex;align-items:center;gap:11px;min-height:44px;padding:11px 13px;font-size:13px;font-weight:650;text-decoration:none;border:1px solid var(--glass-edge, rgba(255,255,255,.9));border-radius:10px;background:var(--paper, #fff);color:var(--ink, #202936);box-shadow:0 2px 5px rgba(32,45,63,.03)}.ds-nav-link:hover{background:var(--raised, #f7f9fc)}.ds-nav-link:focus-visible{outline:3px solid var(--focus, #467caf);outline-offset:3px;}"
    },
    {
      "name": "Booked outcome",
      "kind": "chip",
      "refersTo": "badge-booked",
      "description": "Booked outcome from the implemented silver-frame workspace.",
      "html": "<span class=\"ds-badge\">Booked</span>",
      "css": ".ds-badge{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; display:inline-flex;align-items:center;white-space:nowrap;font-size:11px;font-weight:600;line-height:1.4;border-radius:6px;background:var(--booked-surface, #eaf5ef);color:var(--booked-ink, #31664a);padding:4px 7px}:host-context([data-theme=\"dark\"]) .ds-badge{background:var(--dark-booked-surface, #263d35);color:var(--dark-booked-ink, #a0d5b9)}"
    },
    {
      "name": "Framed sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Framed sheet from the implemented silver-frame workspace.",
      "html": "<section class=\"ds-frame\"><div class=\"ds-sheet\"><h2 class=\"ds-sheet-title\">Call records</h2><p class=\"ds-sheet-copy\">Every conversation, with the details your team needs.</p></div></section>",
      "css": ".ds-frame{background:var(--workspace, #f0f3f7);padding:16px}.ds-sheet{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; padding:30px 32px;background:var(--paper, #fff);color:var(--ink, #202936);border:1px solid var(--glass-edge, rgba(255,255,255,.9));border-radius:20px;box-shadow:var(--shadow,0 8px 28px rgba(30,50,72,.05))}.ds-sheet-title{margin:0 0 8px;font-size:28px;line-height:1.3;letter-spacing:-.035em;font-weight:650}.ds-sheet-copy{margin:0;font-size:13px;color:var(--muted, #5d6876)}"
    },
    {
      "name": "Selected call row",
      "kind": "custom",
      "refersTo": "call-row-selected",
      "description": "Selected call row from the implemented silver-frame workspace.",
      "html": "<button class=\"ds-row\" aria-pressed=\"true\"><strong class=\"ds-row-name\">Demo caller</strong><span class=\"ds-row-phone\">01XXXXXXXXX</span><span class=\"ds-row-meta\"><span>Fictional fixture</span><span>10:32</span></span></button>",
      "css": ".ds-row{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line, #e3e8ee);padding:20px 24px;background:var(--selected, #eaf0f7);color:var(--ink, #202936);cursor:pointer;transition:background-color .18s ease}.ds-row:hover{background:var(--paper, #fff)}.ds-row:focus-visible{outline:3px solid var(--focus, #467caf);outline-offset:3px;}.ds-row-name{font-size:14px;font-weight:600;line-height:1.6}.ds-row-phone{display:block;font-size:12px;color:var(--muted, #5d6876);margin-top:5px;font-variant-numeric:tabular-nums}.ds-row-meta{display:flex;justify-content:space-between;gap:12px;margin-top:13px;font-size:11px;color:var(--muted, #5d6876);font-variant-numeric:tabular-nums}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
    },
    {
      "name": "Assistant transcript turn",
      "kind": "custom",
      "refersTo": "transcript-assistant",
      "description": "Assistant transcript turn from the implemented silver-frame workspace.",
      "html": "<article class=\"ds-turn\"><header class=\"ds-turn-head\"><strong>AI receptionist</strong><time>00:12</time></header><p lang=\"bn\">কীভাবে সাহায্য করতে পারি?</p></article>",
      "css": ".ds-turn{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; background:var(--assistant, #f2f5f9);color:var(--ink, #202936);padding:17px 20px;border-radius:12px}.ds-turn-head{display:flex;align-items:center;gap:10px;font-size:11px;color:var(--muted, #5d6876);margin-bottom:9px}.ds-turn-head strong{font-weight:600;color:var(--ink, #202936)}.ds-turn-head time{margin-left:auto;font-variant-numeric:tabular-nums}.ds-turn p{font-family:\"Noto Sans Bengali\",\"Manrope\",sans-serif;font-size:15px;line-height:1.95;margin:0;overflow-wrap:anywhere}"
    },
    {
      "name": "Record tabs",
      "kind": "nav",
      "refersTo": "sheet",
      "description": "Record tabs from the implemented silver-frame workspace.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Record details\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Conversation</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Captured details</button></div>",
      "css": ".ds-tabs{display:flex;gap:24px;border-bottom:1px solid var(--line, #e3e8ee);padding:0 32px}.ds-tab{font-family:\"Manrope\",\"Noto Sans Bengali\",sans-serif; background:none;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;padding:14px 0;color:var(--muted, #5d6876);font-size:12px;min-height:44px;cursor:pointer}.ds-tab[aria-selected=\"true\"]{color:var(--ink, #202936);border-bottom-color:var(--accent, #335d7e);font-weight:650}.ds-tab:hover{color:var(--ink, #202936)}.ds-tab:focus-visible{outline:3px solid var(--focus, #467caf);outline-offset:3px;}"
    }
