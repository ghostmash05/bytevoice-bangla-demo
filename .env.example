# Server-side only. Never use NEXT_PUBLIC_ for credentials.
LIVEKIT_URL=wss://bytevoice-bangla-yjvpjhfv.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=bangla-receptionist

# Direct Google speech-to-speech; LiveKit still carries audio and Bengali captions.
VOICE_PIPELINE=realtime
REALTIME_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_REALTIME_MODEL=gemini-3.8-live
# Legacy LiveKit-billed realtime path, selected only with REALTIME_PROVIDER=livekit.
REALTIME_MODEL=google/gemini-3.8-live
REALTIME_VOICE=Kore
# Google-native captions: native avoids LiveKit Inference dependency.
# Optional speechmatics/linden-1 uses separate LiveKit inference credits.
REALTIME_STT_MODEL=native

# Alternative VOICE_PIPELINE=chained requires these separate provider accounts.
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=bn-BD-NabanitaNeural

# Uses LiveKit Inference credits; configurable after Bengali/tool-use testing.
LLM_MODEL=google/gemma-4-31b-it

# Clinic backend; python -m backend.setup_local generates local secrets.
BACKEND_URL=http://127.0.0.1:8000
AGENT_API_SECRET=
# Deployed storage: postgresql+psycopg:// URL. Local default: .local/clinic.db.
DATABASE_URL=
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD_HASH=
APP_ENV=development
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
